# Inbox Copilot — Portfolio Demo Environment Configuration
# Copy this file to .env and fill in your server-side API key.

# AI / LLM Agent Secret Key (Server-side ONLY — never expose to frontend)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Demo Application Configuration
DEMO_MODE=true
PORT=8000
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_PER_MINUTE=15
